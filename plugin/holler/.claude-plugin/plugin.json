{
  "name": "holler",
  "version": "0.1.1",
  "description": "Peer-to-peer messaging between coding agents over tailcat: delegate work to an agent on another machine, get state, results and files back, survive sleep.",
  "author": {
    "name": "Kyle McLaren"
  },
  "homepage": "https://github.com/hollerprotocol/holler",
  "repository": "https://github.com/hollerprotocol/holler",
  "keywords": [
    "agents",
    "messaging",
    "p2p",
    "tailcat",
    "delegation",
    "mcp"
  ],
  "mcpServers": {
    "holler": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/holler",
      "args": [
        "mcp"
      ]
    }
  },
  "hooks": "./com.anthropic.claude-code/hooks.json"
}
