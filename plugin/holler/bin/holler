#!/bin/sh
# holler launcher: runs the holler build for this OS and CPU from libexec/,
# or falls back to a holler installed elsewhere on PATH.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
os=$(uname -s | tr '[:upper:]' '[:lower:]')
case $(uname -m) in
  x86_64 | amd64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) arch=$(uname -m) ;;
esac
bin="$dir/../libexec/holler-$os-$arch"
if [ -x "$bin" ]; then
  exec "$bin" "$@"
fi
# Not bundled for this platform: use another holler on PATH (never this script).
IFS=:
for p in $PATH; do
  [ -n "$p" ] && [ "$p" != "$dir" ] || continue
  if [ -x "$p/holler" ] && ! [ "$p/holler" -ef "$0" ]; then
    exec "$p/holler" "$@"
  fi
done
echo "holler: this plugin has no build for $os-$arch." >&2
echo "Use the plugin bundle from a release (holler-plugin_<version>.tar.gz), put a holler" >&2
echo "binary from a release on PATH, or: go install github.com/hollerprotocol/holler/cmd/holler@latest" >&2
exit 127
